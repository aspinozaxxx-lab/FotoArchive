[Unit]
Description=FotoArchive private GPU worker
After=network-online.target

[Service]
Type=simple
User=fotoarchive
Group=fotoarchive
WorkingDirectory=/opt/fotoarchive/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/fotoarchive/app
Environment=LD_LIBRARY_PATH=/data/fotoarchive/runtime/b11009/cudart-llama-b11009-bin-ubuntu-cuda-12.8-x64
ExecStart=/opt/fotoarchive/venv/bin/python -m fotoarchive.remote_service --data /data/fotoarchive --token-file /data/fotoarchive/service-token --passive-pids 3206,4807
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
LimitCORE=0
UMask=0077
Nice=10
CPUQuota=800%
MemoryMax=24G
TasksMax=256
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/fotoarchive
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
